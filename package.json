{
  "name": "recruit-me",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source personal portfolio template + recruiter Fit (JD → cite-or-missing evidence brief).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.2",
    "node": ">=20"
  },
  "scripts": {
    "init": "node scripts/init-site.mjs",
    "dev": "node scripts/dev.mjs",
    "ready": "node scripts/check-ready.mjs",
    "skills": "node scripts/skills.mjs",
    "emit": "python scripts/emit-content.py",
    "emit:evidence": "python scripts/emit-evidence.py",
    "emit:fit-config": "python scripts/emit-fit-config.py",
    "corpus:check": "python scripts/check-fictional-corpus.py",
    "publication:check": "python scripts/check-publication-safety.py",
    "guard:suggest": "node scripts/suggest-guard-terms.mjs",
    "content:check": "python scripts/check-content.py",
    "additive:check": "node scripts/check-additive.mjs",
    "parity:check": "node scripts/check-parity.mjs",
    "secrets:check": "python scripts/check-secrets.py",
    "style:check": "node scripts/check-style-tokens.mjs",
    "config:check": "node scripts/check-adopter-config.mjs",
    "pages:check": "node scripts/check-pages-target.mjs",
    "pages:setup": "node scripts/setup-github-pages.mjs",
    "typecheck": "tsc --noEmit",
    "build:graph": "node scripts/build-graph-vendor.mjs",
    "bundle": "node scripts/build.mjs",
    "build:fit-worker": "node scripts/build-fit-worker.mjs",
    "emit:artifacts": "bun scripts/emit-artifacts.ts",
    "emit:html": "bun scripts/emit-html.ts",
    "emit:seo": "bun scripts/emit-seo-artifacts.ts",
    "prerender": "bun scripts/prerender-routes.ts",
    "build": "bun run emit && bun run typecheck && bun run build:graph && bun run bundle && bun run emit:artifacts && bun run emit:evidence && bun run emit:fit-config && bun run build:fit-worker && node scripts/run-prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "fit:smoke": "bun scripts/fit-smoke.ts",
    "graph:smoke": "node scripts/graph-smoke.mjs",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "csp:smoke": "node scripts/csp-smoke.mjs",
    "ux:check": "node scripts/check-ux.mjs",
    "docs:check": "node scripts/check-doc-drift.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "test": "bun run additive:check && bun run parity:check && bun run corpus:check && bun run content:check && bun run secrets:check && bun run style:check && bun run build && bun run config:check && bun run publication:check && bun run pages:check && bun run fit:smoke && bun run graph:smoke && bun run seo:smoke && bun run csp:smoke && bun run ux:check"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "playwright": "^1.62.1",
    "sigma": "^3.0.3",
    "typescript": "^7.0.2"
  }
}
