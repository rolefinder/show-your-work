{
  "name": "recruit-me",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source personal portfolio template + recruiter Fit (JD \u2192 cite-or-missing evidence brief).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init": "node scripts/init-site.mjs",
    "dev": "node scripts/dev.mjs",
    "ready": "node scripts/check-ready.mjs",
    "skills": "node scripts/skills.mjs",
    "emit": "python scripts/emit-content.py",
    "emit:evidence": "python scripts/emit-evidence.py",
    "emit:fit-config": "python scripts/emit-fit-config.py",
    "corpus:check": "python scripts/check-fictional-corpus.py",
    "content:check": "python scripts/check-content.py",
    "secrets:check": "python scripts/check-secrets.py",
    "style:check": "node scripts/check-style-tokens.mjs",
    "config:check": "node scripts/check-adopter-config.mjs",
    "typecheck": "tsc --noEmit",
    "build:graph": "node scripts/build-graph-vendor.mjs",
    "bundle": "node scripts/build.mjs",
    "build:fit-worker": "node scripts/build-fit-worker.mjs",
    "emit:artifacts": "npx --yes tsx scripts/emit-artifacts.ts",
    "emit:html": "npx --yes tsx scripts/emit-html.ts",
    "emit:seo": "npx --yes tsx scripts/emit-seo-artifacts.ts",
    "prerender": "npx --yes tsx scripts/prerender-routes.ts",
    "build": "npm run emit && npm run typecheck && npm run build:graph && npm run bundle && npm run emit:artifacts && npm run emit:evidence && npm run emit:fit-config && npm run build:fit-worker && node scripts/run-prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "fit:smoke": "npx --yes tsx scripts/fit-smoke.ts",
    "graph:smoke": "node scripts/graph-smoke.mjs",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "ux:check": "node scripts/check-ux.mjs",
    "docs:check": "node scripts/check-doc-drift.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "test": "npm run corpus:check && npm run content:check && npm run secrets:check && npm run style:check && npm run build && npm run config:check && npm run fit:smoke && npm run graph:smoke && npm run seo:smoke && npm run ux:check"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "playwright": "^1.62.0",
    "sigma": "^3.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
