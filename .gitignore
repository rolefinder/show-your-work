# This repo is Node/TypeScript with a handful of Python build scripts. It used
# to carry GitHub's full Python template — ~250 lines of Django, Scrapy, Celery,
# RabbitMQ and SageMath patterns for a repo that has none of them. That noise
# was not free: the unanchored `lib/` rule silently excluded scripts/lib/, which
# holds the route table the build cannot run without, so a fresh clone failed.
# Keep this file short enough that every line can be justified.

# Build output
dist/
# generated by build-fit-worker.mjs from src/fit/
functions/_lib/

# Dependencies
node_modules/

# Cloudflare — only wrangler.example.toml is committed; a real one has bindings
wrangler.toml
.wrangler/

# Terms you never want published. Deliberately NOT committed: writing a
# codename into a tracked file publishes the codename. See /sanitize.
content/config/corpus-guard.local.yaml

# Secrets and local environment
.env
.env.*
*.pem
*.key

# Python (scripts/ and packages/ are the only Python here)
__pycache__/
*.py[cod]
.venv/
venv/

# Agent tooling: worktrees are whole nested checkouts, and settings.local.json
# is per-developer. Both are easy to commit by accident from a fork.
.claude/worktrees/
.claude/settings.local.json

# Packaging / editors / OS
*.tgz
.vscode/
.idea/
.DS_Store
Thumbs.db
